@inherits LayoutComponentBase

<div class="min-h-screen flex flex-col bg-slate-50">
    <!-- Premium Navbar -->
    <header class="bg-indigo-900 text-white shadow-md px-6 py-4 flex items-center justify-between">
        <div class="flex items-center space-x-3">
            <span class="text-2xl">⚡</span>
            <div>
                <h1 class="text-lg font-extrabold tracking-wider leading-none">NOVO SEI</h1>
                <span class="text-xs text-indigo-300 font-semibold tracking-widest uppercase">Sistema Eletrônico de Informações</span>
            </div>
        </div>
        <div class="flex items-center space-x-4">
            <a href="/" class="text-sm text-indigo-200 hover:text-white transition-colors font-medium">📥 Caixa de Entrada</a>
            <a href="/dashboard" class="text-sm text-indigo-200 hover:text-white transition-colors font-medium">📊 Dashboard</a>
            <a href="/ingestao" class="text-sm text-indigo-200 hover:text-white transition-colors font-medium font-semibold">🔄 Ingestão Legado</a>
            <a href="/seguranca" class="text-sm text-indigo-200 hover:text-white transition-colors font-medium">🔐 Segurança 2FA</a>
            <a href="/blocos" class="text-sm text-indigo-200 hover:text-white transition-colors font-medium">🤝 Blocos de Reunião</a>
            <span class="text-sm bg-indigo-800 border border-indigo-700 px-3 py-1 rounded-full text-indigo-200 font-medium">
                Modo: Interactive Server
            </span>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 flex flex-col">
        @Body
    </main>
</div>
