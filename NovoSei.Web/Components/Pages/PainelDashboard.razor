@page "/dashboard"
@using Microsoft.EntityFrameworkCore
@using NovoSei.Core.Entities
@using NovoSei.Core.DTOs
@using NovoSei.Core.Interfaces
@using NovoSei.Infrastructure.Data
@using Microsoft.AspNetCore.Components.Authorization
@inject ApplicationDbContext Db
@inject IDashboardService DashboardService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Dashboard - Novo SEI</PageTitle>

<div class="container mx-auto px-6 py-8 max-w-7xl space-y-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-200 pb-5">
        <div>
            <h1 class="text-3xl font-extrabold text-slate-800 tracking-tight flex items-center gap-2">
                📊 Painel de Indicadores
            </h1>
            <p class="text-slate-500 mt-1.5 text-sm">
                Acompanhe o resumo de suas atividades, responsabilidades e rascunhos em tempo real.
            </p>
        </div>
        <div class="flex items-center gap-3">
            @if (usuarioLogado != null)
            {
                <span class="text-xs bg-slate-100 text-slate-600 px-3 py-1.5 rounded-lg border border-slate-200">
                    Usuário: <strong>@usuarioLogado.Nome</strong>
                </span>
            }
            <button @onclick="RecarregarManual" class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-md shadow-indigo-100 hover:shadow-lg transition-all text-sm flex items-center gap-1.5">
                <span>🔄</span> Atualizar Métricas
            </button>
        </div>
    </div>

    @if (carregando)
    {
        <div class="flex flex-col items-center justify-center min-h-[300px]">
            <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-indigo-600 mb-4"></div>
            <p class="text-slate-500 text-sm">Carregando indicadores...</p>
        </div>
    }
    else if (indicadores != null)
    {
        <!-- Indicadores Cards Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <!-- Card 1: Total Processos -->
            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm hover:shadow-md hover:scale-[1.01] transition-all duration-300 flex items-center justify-between">
                <div class="space-y-1.5">
                    <span class="text-xs font-extrabold uppercase tracking-widest text-slate-400">Total de Processos</span>
                    <h3 class="text-3xl font-black text-slate-800 tracking-tight">@indicadores.TotalProcessos</h3>
                    <p class="text-[11px] text-slate-500 font-light">Sob sua responsabilidade</p>
                </div>
                <div class="flex items-center justify-center w-12 h-12 rounded-2xl bg-blue-50 border border-blue-100 text-blue-600 text-xl font-bold">
                    📂
                </div>
            </div>

            <!-- Card 2: Processos Abertos -->
            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm hover:shadow-md hover:scale-[1.01] transition-all duration-300 flex items-center justify-between">
                <div class="space-y-1.5">
                    <span class="text-xs font-extrabold uppercase tracking-widest text-slate-400">Processos Abertos</span>
                    <h3 class="text-3xl font-black text-indigo-700 tracking-tight">@indicadores.ProcessosAbertos</h3>
                    <p class="text-[11px] text-slate-500 font-light">Em andamento na caixa</p>
                </div>
                <div class="flex items-center justify-center w-12 h-12 rounded-2xl bg-indigo-50 border border-indigo-100 text-indigo-600 text-xl font-bold">
                    ⚡
                </div>
            </div>

            <!-- Card 3: Rascunhos Pendentes -->
            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm hover:shadow-md hover:scale-[1.01] transition-all duration-300 flex items-center justify-between">
                <div class="space-y-1.5">
                    <span class="text-xs font-extrabold uppercase tracking-widest text-slate-400">Rascunhos Pendentes</span>
                    <h3 class="text-3xl font-black text-amber-600 tracking-tight">@indicadores.RascunhosPendentes</h3>
                    <p class="text-[11px] text-slate-500 font-light">Aguardando sua assinatura</p>
                </div>
                <div class="flex items-center justify-center w-12 h-12 rounded-2xl bg-amber-50 border border-amber-100 text-amber-600 text-xl font-bold">
                    ✍️
                </div>
            </div>

            <!-- Card 4: Trâmites Realizados -->
            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm hover:shadow-md hover:scale-[1.01] transition-all duration-300 flex items-center justify-between">
                <div class="space-y-1.5">
                    <span class="text-xs font-extrabold uppercase tracking-widest text-slate-400">Trâmites Realizados</span>
                    <h3 class="text-3xl font-black text-emerald-600 tracking-tight">@indicadores.TramitesRealizados</h3>
                    <p class="text-[11px] text-slate-500 font-light">Assinaturas e ações efetuadas</p>
                </div>
                <div class="flex items-center justify-center w-12 h-12 rounded-2xl bg-emerald-50 border border-emerald-100 text-emerald-600 text-xl font-bold">
                    🛡️
                </div>
            </div>
        </div>
    }
</div>

@code {
    private Usuario? usuarioLogado;
    private DashboardDto? indicadores;
    private bool carregando = true;

    protected override async Task OnInitializedAsync()
    {
        await CarregarIndicadores();
    }

    private async Task CarregarIndicadores()
    {
        carregando = true;
        
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userClaims = authState.User;
        var login = userClaims.FindFirst("login")?.Value ?? userClaims.Identity?.Name ?? "admin";

        usuarioLogado = await Db.Usuarios
            .Include(u => u.Unidades)
            .FirstOrDefaultAsync(u => u.Login == login);
            
        if (usuarioLogado == null)
        {
            usuarioLogado = await Db.Usuarios.Include(u => u.Unidades).FirstOrDefaultAsync();
        }

        if (usuarioLogado != null)
        {
            indicadores = await DashboardService.ObterIndicadoresAsync(usuarioLogado.Id);
        }
        else
        {
            indicadores = new DashboardDto(0, 0, 0, 0);
        }

        carregando = false;
    }

    private async Task RecarregarManual()
    {
        if (usuarioLogado != null)
        {
            await DashboardService.InvalidarCacheAsync(usuarioLogado.Id);
            await CarregarIndicadores();
        }
    }
}
