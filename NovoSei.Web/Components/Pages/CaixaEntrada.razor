@page "/"
@using Microsoft.EntityFrameworkCore
@using NovoSei.Core.Entities
@using NovoSei.Core.DTOs
@using NovoSei.Core.Interfaces
@using NovoSei.Infrastructure.Data
@using Microsoft.AspNetCore.Components.Authorization
@inject ApplicationDbContext Db
@inject IDashboardService DashboardService
@inject IMarcadorService MarcadorService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ISlaCalculatorService SlaCalculator
@inject IControlePrazoService ControlePrazoService
@rendermode InteractiveServer

<div class="container mx-auto p-6 max-w-7xl">
    <!-- Page Title & Create Button -->
    <div class="mb-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white border border-slate-200 rounded-xl p-6 shadow-sm">
        <div>
            <h2 class="text-3xl font-black text-slate-900 tracking-tight flex items-center gap-2">
                <span>📥</span> Caixa de Entrada
            </h2>
            <p class="text-slate-600 mt-1 font-light">Selecione um processo para visualizar a árvore de documentos e assinar.</p>
        </div>
        <div class="flex gap-2">
            <a href="/marcadores" class="px-4 py-2 bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 font-bold text-sm rounded-lg transition-colors flex items-center gap-1.5 shadow-sm">
                <span>🏷️</span> Gerenciar Marcadores
            </a>
            <button @onclick="AbrirModalNovoProcesso" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm rounded-lg transition-colors flex items-center gap-1.5 shadow-sm">
                <span>➕</span> Novo Processo
            </button>
        </div>
    </div>

    <!-- Batch Actions Bar -->
    @if (processosSelecionados.Count > 0)
    {
        <div class="mb-6 p-4 bg-indigo-50 border border-indigo-200 rounded-xl flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 shadow-sm">
            <div class="text-xs text-indigo-900 font-bold">
                <span>Selecionado(s):</span> @processosSelecionados.Count @(processosSelecionados.Count == 1 ? "processo" : "processos")
            </div>
            <div class="flex items-center gap-3 flex-wrap">
                <span class="text-xs font-bold text-slate-700">Aplicar Marcador:</span>
                <select @bind="marcadorLoteId" class="text-xs px-2.5 py-1.5 border border-slate-250 bg-white rounded-lg focus:outline-none focus:border-indigo-500">
                    <option value="0">-- Selecione --</option>
                    @foreach (var m in marcadoresDisponiveis.Where(m => m.Ativo))
                    {
                        <option value="@m.Id">@m.Nome</option>
                    }
                </select>
                <button @onclick="AplicarMarcadorEmLote" disabled="@(marcadorLoteId == 0)" 
                        class="px-3.5 py-1.5 bg-indigo-600 hover:bg-indigo-700 disabled:bg-slate-300 disabled:cursor-not-allowed text-white font-bold text-xs rounded-lg transition-colors shadow-sm">
                    Aplicar
                </button>
                <button @onclick="RemoverMarcadoresEmLote" 
                        class="px-3.5 py-1.5 bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs rounded-lg transition-colors shadow-sm">
                    Limpar Marcadores
                </button>
                <button @onclick="() => processosSelecionados.Clear()" 
                        class="px-3 py-1.5 bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold text-xs rounded-lg transition-colors">
                    Cancelar
                </button>
            </div>
        </div>
    }

    <!-- Process Table -->
    @if (processos == null)
    {
        <div class="flex flex-col items-center justify-center min-h-[200px]">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600 mb-2"></div>
            <p class="text-slate-500 text-sm">Carregando processos...</p>
        </div>
    }
    else if (!processos.Any())
    {
        <div class="bg-slate-50 border border-slate-200 border-dashed rounded-xl p-12 text-center">
            <span class="text-4xl mb-3 block">📭</span>
            <h3 class="text-base font-bold text-slate-700">Nenhum processo cadastrado</h3>
            <p class="text-slate-500 text-xs mt-1">Nenhum processo ativo foi encontrado na base de dados.</p>
        </div>
    }
    else
    {
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
            <table class="min-w-full divide-y divide-slate-100">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3.5 text-left text-xs font-bold text-slate-500 uppercase tracking-wider w-10">
                            <input type="checkbox" @onchange="AlternarTodosProcessos" checked="@(processosSelecionados.Count == processos.Count && processos.Count > 0)" />
                        </th>
                        <th class="px-6 py-3.5 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Número Sequencial</th>
                        <th class="px-6 py-3.5 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Assunto</th>
                        <th class="px-6 py-3.5 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-3.5 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Prazo</th>
                        <th class="px-6 py-3.5 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Responsável</th>
                        <th class="px-6 py-3.5 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Ações</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 bg-white">
                    @foreach (var p in processos)
                    {
                        var isSelecionado = processosSelecionados.Contains(p.Id);
                        <tr class="hover:bg-slate-50/50 transition-colors @(isSelecionado ? "bg-indigo-50/5" : "")">
                            <td class="px-4 py-4 whitespace-nowrap text-sm">
                                <input type="checkbox" checked="@isSelecionado" @onchange="() => AlternarSelecaoProcesso(p.Id)" />
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-slate-900">
                                <div class="flex flex-col">
                                    <span>@p.NumeroSequencial</span>
                                    @if (p.Marcadores != null && p.Marcadores.Any())
                                    {
                                        <div class="flex flex-wrap gap-1 mt-1">
                                            @foreach (var m in p.Marcadores)
                                            {
                                                <span class="inline-block px-1.5 py-0.5 rounded text-[9px] font-bold text-white shadow-sm" style="background-color: @m.CorHex;">
                                                    @m.Nome
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            </td>
                            <td class="px-6 py-4 text-sm text-slate-600 max-w-xs truncate">
                                <div class="flex flex-col gap-1">
                                    <span class="font-medium">@p.Assunto</span>
                                    <div class="flex flex-wrap items-center gap-1.5 mt-0.5">
                                        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-700 border border-slate-200">
                                            📁 @p.Tipo
                                        </span>
                                        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold @(p.NivelAcesso == "Público" ? "bg-emerald-50 text-emerald-700 border border-emerald-100" : p.NivelAcesso == "Restrito" ? "bg-amber-50 text-amber-700 border border-amber-100" : "bg-rose-50 text-rose-700 border border-rose-100")">
                                            🔒 @p.NivelAcesso
                                        </span>
                                        @if (!string.IsNullOrEmpty(p.Interessados))
                                        {
                                            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-indigo-50 text-indigo-700 border border-indigo-100" title="Interessados: @p.Interessados">
                                                👥 @p.Interessados
                                            </span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm">
                                <span class="text-xs font-semibold px-2 py-1 rounded-full border @(p.Status == "Aberto" ? "bg-indigo-50 text-indigo-700 border-indigo-100" : "bg-slate-100 text-slate-600 border-slate-150")">
                                    @p.Status
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm">
                                @if (prazosProcessos.TryGetValue(p.Id, out var info))
                                {
                                    var (prazo, diasRestantes) = info;
                                    var alertClass = "bg-emerald-50 text-emerald-700 border-emerald-100";
                                    var statusText = "Em dia";
                                    var daysWord = Math.Abs(diasRestantes) == 1 ? "dia" : "dias";

                                    if (diasRestantes <= 0)
                                    {
                                        alertClass = "bg-red-50 text-red-700 border-red-150 animate-pulse";
                                        statusText = diasRestantes == 0 ? "Vence hoje" : $"Atrasado há {Math.Abs(diasRestantes)} {daysWord}";
                                    }
                                    else if (diasRestantes <= 5)
                                    {
                                        alertClass = "bg-amber-50 text-amber-700 border-amber-100";
                                        statusText = $"{diasRestantes} {daysWord} restantes";
                                    }
                                    else
                                    {
                                        statusText = $"{diasRestantes} {daysWord} restantes";
                                    }

                                    <div class="flex items-center gap-1.5" title="Definido por @(prazo.CriadoPorUsuario?.Nome ?? "Sistema") em @prazo.DataLimite.ToString("dd/MM/yyyy") @(prazo.DiasUteis ? "(Dias Úteis)" : "(Dias Corridos)")">
                                        <span class="text-xs font-bold px-2 py-1 rounded-full border @alertClass">
                                            ⏱️ @statusText
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-xs text-slate-400 italic font-light">-</span>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500 font-light">
                                @(p.Usuario?.Nome ?? "Sistema")
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                <button @onclick="() => AbrirProcesso(p.Id)" class="px-3 py-1.5 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold rounded-lg border border-indigo-200 transition-colors text-xs flex items-center gap-1">
                                    <span>👁️</span> Abrir
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (exibindoModalNovoProcesso)
{
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center z-50 p-4 animate-in fade-in duration-150">
        <div class="bg-white rounded-3xl w-full max-w-lg shadow-2xl border border-slate-100 p-6 space-y-5 animate-in zoom-in-95 duration-150">
            <div class="flex justify-between items-center border-b border-slate-100 pb-3">
                <h3 class="text-xl font-black text-slate-800 flex items-center gap-2">
                    <span>📂</span> Autuar Novo Processo
                </h3>
                <button @onclick="FecharModalNovoProcesso" class="text-slate-400 hover:text-slate-600 text-lg">✕</button>
            </div>
            
            <div class="space-y-4">
                <div class="p-3 bg-indigo-50 border border-indigo-100 rounded-xl text-[11px] text-indigo-700 leading-relaxed flex items-start gap-2">
                    <span>ℹ️</span>
                    <span>O <strong>Número Único de Protocolo (NUP)</strong> oficial da legislação federal será gerado automaticamente pelo sistema após a criação.</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Tipo de Processo <span class="text-rose-500">*</span></label>
                        <select @bind="novoTipo" class="w-full text-xs px-3.5 py-2.5 border border-slate-200 rounded-xl focus:outline-none focus:border-indigo-500 bg-white">
                            <option value="Pessoal: Férias">Pessoal: Férias</option>
                            <option value="Licitação">Licitação</option>
                            <option value="Contratos">Contratos</option>
                            <option value="Administrativo: Aquisições">Administrativo: Aquisições</option>
                            <option value="Pessoal: Licença">Pessoal: Licença</option>
                            <option value="Jurídico: Parecer">Jurídico: Parecer</option>
                        </select>
                    </div>

                    <div class="space-y-1">
                        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Nível de Acesso <span class="text-rose-500">*</span></label>
                        <select @bind="novoNivelAcesso" class="w-full text-xs px-3.5 py-2.5 border border-slate-200 rounded-xl focus:outline-none focus:border-indigo-500 bg-white">
                            <option value="Público">Público</option>
                            <option value="Restrito">Restrito</option>
                            <option value="Sigiloso">Sigiloso</option>
                        </select>
                    </div>
                </div>

                <div class="space-y-1">
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Especificação / Assunto <span class="text-rose-500">*</span></label>
                    <textarea @bind="novoAssunto" placeholder="Ex: Solicitação de aquisição de novos equipamentos de TI para o setor de desenvolvimento." rows="3"
                              class="w-full text-xs px-3.5 py-2.5 border border-slate-200 rounded-xl focus:outline-none focus:border-indigo-500 bg-white resize-none"></textarea>
                </div>

                <div class="space-y-1">
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Interessados (Opcional)</label>
                    <input type="text" @bind="novoInteressados" placeholder="Ex: João da Silva, Maria Souza (separados por vírgula)"
                           class="w-full text-xs px-3.5 py-2.5 border border-slate-200 rounded-xl focus:outline-none focus:border-indigo-500 bg-white" />
                </div>
                
                <div class="space-y-1">
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Unidade <span class="text-rose-500">*</span></label>
                    <select @bind="novoUnidadeId" 
                            class="w-full text-xs px-3.5 py-2.5 border border-slate-200 rounded-xl focus:outline-none focus:border-indigo-500 bg-white">
                        <option value="">-- Selecione a Unidade --</option>
                        @foreach (var u in todasUnidades)
                        {
                            <option value="@u.Id">@u.Sigla - @u.Descricao</option>
                        }
                    </select>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(mensagemErroModal))
            {
                <div class="p-3 bg-rose-50 border border-rose-100 rounded-xl text-xs text-rose-600 font-semibold flex items-center gap-1.5">
                    <span>⚠️</span> @mensagemErroModal
                </div>
            }

            <div class="flex gap-3 justify-end pt-3 border-t border-slate-100">
                <button @onclick="FecharModalNovoProcesso" class="px-4 py-2 rounded-xl text-slate-600 hover:bg-slate-100 font-semibold text-xs transition-all">
                    Cancelar
                </button>
                <button @onclick="SalvarNovoProcesso" class="px-4 py-2 bg-indigo-600 text-white font-bold rounded-xl hover:bg-indigo-700 transition-all text-xs shadow-sm flex items-center gap-1">
                    <span>💾</span> Salvar Processo
                </button>
            </div>
        </div>
    </div>
}

@code {
    private Usuario? usuarioLogado;
    private int? activeUnidadeId;
    private List<Processo>? processos;
    private Dictionary<int, (ControlePrazo Prazo, int DiasRestantes)> prazosProcessos = new();
    
    // Selection and tagging variables
    private HashSet<int> processosSelecionados = [];
    private List<Marcador> marcadoresDisponiveis = [];
    private int marcadorLoteId = 0;

    // Modal creation variables
    private bool exibindoModalNovoProcesso = false;
    private string novoNumeroSequencial = string.Empty;
    private string novoAssunto = string.Empty;
    private string novoTipo = "Pessoal: Férias";
    private string novoInteressados = string.Empty;
    private string novoNivelAcesso = "Público";
    private int? novoUnidadeId;
    private List<Unidade> todasUnidades = [];
    private string mensagemErroModal = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        // 1. Identificar usuário
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userClaims = authState.User;
        var login = userClaims.FindFirst("login")?.Value ?? userClaims.Identity?.Name ?? "admin";

        usuarioLogado = await Db.Usuarios
            .Include(u => u.Unidades)
            .FirstOrDefaultAsync(u => u.Login == login);
            
        if (usuarioLogado == null)
        {
            usuarioLogado = await Db.Usuarios.Include(u => u.Unidades).FirstOrDefaultAsync();
        }

        // 2. Identificar Unidade ativa
        if (usuarioLogado != null)
        {
            var uni = usuarioLogado.Unidades.FirstOrDefault();
            activeUnidadeId = uni?.Id ?? (await Db.Unidades.FirstOrDefaultAsync())?.Id;
        }

        // 3. Listar Processos com Marcadores
        processos = await Db.Processos
            .Include(p => p.Usuario)
            .Include(p => p.Marcadores)
            .Include(p => p.ControlePrazos)
            .OrderByDescending(p => p.CriadoEm)
            .ToListAsync();

        // 4. Carregar marcadores da unidade
        if (activeUnidadeId.HasValue)
        {
            marcadoresDisponiveis = await MarcadorService.ObterMarcadoresDaUnidadeAsync(activeUnidadeId.Value);

            // Carregar e calcular os prazos ativos
            prazosProcessos.Clear();
            if (processos != null)
            {
                foreach (var p in processos)
                {
                    var prazoAtivo = p.ControlePrazos.FirstOrDefault(c => c.UnidadeId == activeUnidadeId.Value && c.Status == "Ativo");
                    if (prazoAtivo != null)
                    {
                        int dias = await SlaCalculator.CalcularDiasRestantesAsync(prazoAtivo.DataLimite, prazoAtivo.DiasUteis);
                        prazosProcessos[p.Id] = (prazoAtivo, dias);
                    }
                }
            }
        }

        // 5. Carregar todas as unidades para o dropdown
        todasUnidades = await Db.Unidades.OrderBy(u => u.Sigla).ToListAsync();
    }

    private void AbrirProcesso(int id)
    {
        Navigation.NavigateTo($"/processo/{id}");
    }

    private void AlternarSelecaoProcesso(int id)
    {
        if (processosSelecionados.Contains(id))
        {
            processosSelecionados.Remove(id);
        }
        else
        {
            processosSelecionados.Add(id);
        }
    }

    private void AlternarTodosProcessos(ChangeEventArgs e)
    {
        var checkedState = e.Value is bool b && b;
        if (checkedState && processos != null)
        {
            processosSelecionados = processos.Select(p => p.Id).ToHashSet();
        }
        else
        {
            processosSelecionados.Clear();
        }
    }

    private async Task AplicarMarcadorEmLote()
    {
        if (marcadorLoteId == 0 || !processosSelecionados.Any()) return;
        
        try
        {
            var ok = await MarcadorService.AssociarMarcadoresAoProcessoEmLoteAsync(processosSelecionados.ToList(), marcadorLoteId);
            if (ok)
            {
                processosSelecionados.Clear();
                marcadorLoteId = 0;
                await CarregarDados();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao associar marcadores em lote: {ex.Message}");
        }
    }

    private async Task RemoverMarcadoresEmLote()
    {
        if (!processosSelecionados.Any()) return;
        
        try
        {
            foreach (var pId in processosSelecionados)
            {
                var proc = await Db.Processos.Include(p => p.Marcadores).FirstOrDefaultAsync(p => p.Id == pId);
                if (proc != null)
                {
                    proc.Marcadores.Clear();
                }
            }
            await Db.SaveChangesAsync();
            processosSelecionados.Clear();
            await CarregarDados();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao limpar marcadores em lote: {ex.Message}");
        }
    }

    private void AbrirModalNovoProcesso()
    {
        novoNumeroSequencial = string.Empty;
        novoAssunto = string.Empty;
        novoTipo = "Pessoal: Férias";
        novoInteressados = string.Empty;
        novoNivelAcesso = "Público";
        novoUnidadeId = activeUnidadeId;
        mensagemErroModal = string.Empty;
        exibindoModalNovoProcesso = true;
    }

    private void FecharModalNovoProcesso()
    {
        exibindoModalNovoProcesso = false;
    }

    private async Task SalvarNovoProcesso()
    {
        if (string.IsNullOrWhiteSpace(novoAssunto))
        {
            mensagemErroModal = "O campo Assunto / Descrição é obrigatório.";
            return;
        }

        if (!novoUnidadeId.HasValue || novoUnidadeId.Value == 0)
        {
            mensagemErroModal = "Selecione uma Unidade válida.";
            return;
        }

        try
        {
            string finalNup = string.Empty;
            int attempt = 0;
            var currentYear = DateTime.UtcNow.Year;
            var startOfYear = new DateTime(currentYear, 1, 1, 0, 0, 0, DateTimeKind.Utc);
            var endOfYear = new DateTime(currentYear, 12, 31, 23, 59, 59, DateTimeKind.Utc);
            var countThisYear = await Db.Processos.CountAsync(p => p.CriadoEm >= startOfYear && p.CriadoEm <= endOfYear);

            do
            {
                var sequenceNum = countThisYear + 1 + attempt;
                var base15 = $"{novoUnidadeId.Value.ToString("D5")}{sequenceNum.ToString("D6")}{currentYear.ToString("D4")}";
                
                // Calculate Módulo 11 DVs
                // 1st DV
                int sum1 = 0;
                int weight1 = 2;
                for (int i = 14; i >= 0; i--)
                {
                    sum1 += (base15[i] - '0') * weight1;
                    weight1++;
                }
                int resto1 = sum1 % 11;
                int dv1 = 11 - resto1;
                if (dv1 >= 10) dv1 = 0;

                // 2nd DV
                string base16 = base15 + dv1.ToString();
                int sum2 = 0;
                int weight2 = 2;
                for (int i = 15; i >= 0; i--)
                {
                    sum2 += (base16[i] - '0') * weight2;
                    weight2++;
                }
                int resto2 = sum2 % 11;
                int dv2 = 11 - resto2;
                if (dv2 >= 10) dv2 = 0;

                var block1 = base15.Substring(0, 5);
                var block2 = base15.Substring(5, 6);
                var block3 = base15.Substring(11, 4);
                
                finalNup = $"{block1}.{block2}/{block3}-{dv1}{dv2}";
                attempt++;
            } while (await Db.Processos.AnyAsync(p => p.NumeroSequencial == finalNup));

            var userToAssign = usuarioLogado ?? await Db.Usuarios.FirstOrDefaultAsync();
            if (userToAssign == null)
            {
                mensagemErroModal = "Nenhum usuário cadastrado no sistema para ser o responsável.";
                return;
            }

            var novoProcesso = new Processo
            {
                NumeroSequencial = finalNup,
                Assunto = novoAssunto.Trim(),
                Status = "Aberto",
                CriadoEm = DateTime.UtcNow,
                UsuarioId = userToAssign.Id,
                UnidadeId = novoUnidadeId,
                Tipo = novoTipo,
                Interessados = string.IsNullOrWhiteSpace(novoInteressados) ? null : novoInteressados.Trim(),
                NivelAcesso = novoNivelAcesso
            };
            Db.Processos.Add(novoProcesso);
            await Db.SaveChangesAsync();

            // Criar documento padrão de abertura
            var template = await Db.TemplatesDocumento.FirstOrDefaultAsync(t => t.Ativo);
            if (template == null)
            {
                template = new TemplateDocumento
                {
                    Nome = "Template Legado Importado",
                    ConteudoHtmlBase = @"
                        <div class='legacy-document-wrapper'>
                            <h2 style='text-align:center;'>DOCUMENTO DE ABERTURA</h2>
                            <hr />
                            <div class='legacy-content'>
                                {{TextoConteudo}}
                            </div>
                        </div>",
                    Ativo = true,
                    CriadoEm = DateTime.UtcNow
                };
                Db.TemplatesDocumento.Add(template);
                await Db.SaveChangesAsync();
            }

            var documento = new Documento
            {
                ProcessoId = novoProcesso.Id,
                TemplateDocumentoId = template.Id,
                Titulo = "Ofício de Abertura",
                ConteudoHtml = template.ConteudoHtmlBase.Replace("{{TextoConteudo}}", "<p>Processo autuado eletronicamente.</p>"),
                Status = "Rascunho",
                CriadoEm = DateTime.UtcNow,
                UnidadeId = novoUnidadeId
            };
            Db.Documentos.Add(documento);
            await Db.SaveChangesAsync();

            // Invalida cache de dashboard
            if (usuarioLogado != null)
            {
                await DashboardService.InvalidarCacheAsync(usuarioLogado.Id);
            }

            // Recarregar lista e fechar modal
            await CarregarDados();
            exibindoModalNovoProcesso = false;
        }
        catch (Exception ex)
        {
            mensagemErroModal = $"Erro ao salvar o processo: {ex.Message}";
        }
    }
}
