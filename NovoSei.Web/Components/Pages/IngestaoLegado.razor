@page "/ingestao"
@using NovoSei.Core.Interfaces
@inject IIngestaoLegacyService IngestaoService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="container mx-auto p-6 max-w-4xl">
    <!-- Header -->
    <div class="mb-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white border border-slate-200 rounded-xl p-6 shadow-sm">
        <div>
            <div class="flex items-center space-x-2 text-sm text-slate-500 mb-2">
                <a href="/" class="hover:text-indigo-600 transition-colors">Caixa de Entrada</a>
                <span>/</span>
                <span class="text-slate-700 font-medium">Ingestão de Dados</span>
            </div>
            <h2 class="text-3xl font-black text-slate-900 tracking-tight flex items-center gap-2">
                <span>🔄</span> Ingestão do SEI Legado
            </h2>
            <p class="text-slate-600 mt-1 font-light">Importe processos, rascunhos, documentos e assinaturas eletrônicas diretamente da base legada.</p>
        </div>
    </div>

    @if (carregandoStats)
    {
        <div class="bg-white border border-slate-200 rounded-xl p-12 text-center shadow-sm">
            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-indigo-600 mx-auto mb-4"></div>
            <p class="text-slate-600 font-medium">Analisando base de dados do SEI legado...</p>
        </div>
    }
    else if (erroStats != null)
    {
        <div class="bg-red-50 border border-red-200 rounded-xl p-6 text-center shadow-sm">
            <h3 class="text-lg font-bold text-red-800 mb-2">Conexão com base Legada</h3>
            <p class="text-red-600 mb-4">@erroStats</p>
            <button @onclick="CarregarStats" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors font-bold text-sm">
                Tentar Conectar Novamente
            </button>
        </div>
    }
    else
    {
        <!-- Legacy Stats Card -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
            <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm">
                <div class="text-2xl mb-1">👥</div>
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Usuários Ativos</div>
                <div class="text-2xl font-black text-slate-800 mt-1">@(stats?.TotalUsuariosLegado ?? 0)</div>
            </div>
            <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm">
                <div class="text-2xl mb-1">📂</div>
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Processos (Total)</div>
                <div class="text-2xl font-black text-slate-800 mt-1">@(stats?.TotalProcessosLegado ?? 0)</div>
            </div>
            <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm">
                <div class="text-2xl mb-1">📄</div>
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Documentos</div>
                <div class="text-2xl font-black text-slate-800 mt-1">@(stats?.TotalDocumentosLegado ?? 0)</div>
            </div>
            <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm">
                <div class="text-2xl mb-1">🔏</div>
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Assinaturas</div>
                <div class="text-2xl font-black text-slate-800 mt-1">@(stats?.TotalAssinaturasLegado ?? 0)</div>
            </div>
        </div>

        <!-- Ingestion Control Card -->
        <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm mb-8">
            <h3 class="text-lg font-black text-slate-800 mb-2 flex items-center gap-2">
                <span>⚙️</span> Painel de Controle de Ingestão
            </h3>
            <p class="text-slate-600 text-sm font-light mb-6">
                O processo de ingestão irá migrar todos os dados mapeados acima para o novo esquema do **Novo SEI**.
                Registros existentes com o mesmo login (usuários) ou número sequencial (processos) serão ignorados para evitar duplicidades.
            </p>

            @if (processando)
            {
                <div class="space-y-4">
                    <div class="flex items-center space-x-3 text-sm text-indigo-600 font-semibold">
                        <div class="animate-spin rounded-full h-5 w-5 border-b-2 border-indigo-600"></div>
                        <span>Ingestão em andamento... Por favor, aguarde.</span>
                    </div>
                    <div class="w-full bg-slate-100 rounded-full h-2">
                        <div class="bg-indigo-600 h-2 rounded-full animate-pulse" style="width: 100%"></div>
                    </div>
                </div>
            }
            else
            {
                <div class="flex flex-col sm:flex-row gap-3">
                    <button @onclick="IniciarIngestao" class="px-6 py-3 bg-gradient-to-r from-indigo-600 to-violet-600 text-white font-bold text-sm rounded-lg hover:from-indigo-700 hover:to-violet-700 transition-all shadow-sm flex items-center gap-2">
                        <span>🚀</span> Iniciar Ingestão de Dados
                    </button>
                    <button @onclick="IniciarIngestaoLimpa" class="px-6 py-3 bg-rose-600 hover:bg-rose-700 text-white font-bold text-sm rounded-lg transition-all shadow-sm flex items-center gap-2">
                        <span>🗑️</span> Limpar Banco e Re-Ingerir
                    </button>
                    <a href="/" class="px-6 py-3 bg-slate-100 text-slate-600 font-bold text-sm rounded-lg hover:bg-slate-200 transition-colors text-center">
                        Voltar para Caixa de Entrada
                    </a>
                </div>
            }
        </div>

        <!-- Result Card -->
        @if (resultado != null)
        {
            @if (resultado.Sucesso)
            {
                <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-6 shadow-sm space-y-4">
                    <h3 class="text-lg font-bold text-emerald-800 flex items-center gap-2">
                        <span>✅</span> Ingestão Concluída com Sucesso!
                    </h3>
                    <p class="text-emerald-700 text-sm font-light">
                        @resultado.Mensagem
                    </p>
                    
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-2">
                        <div class="bg-white/80 border border-emerald-100 rounded-lg p-3 text-center">
                            <span class="text-xs text-slate-500 font-medium">Usuários</span>
                            <div class="text-lg font-extrabold text-emerald-800 mt-0.5">@resultado.UsuariosImportados</div>
                        </div>
                        <div class="bg-white/80 border border-emerald-100 rounded-lg p-3 text-center">
                            <span class="text-xs text-slate-500 font-medium">Processos</span>
                            <div class="text-lg font-extrabold text-emerald-800 mt-0.5">@resultado.ProcessosImportados</div>
                        </div>
                        <div class="bg-white/80 border border-emerald-100 rounded-lg p-3 text-center">
                            <span class="text-xs text-slate-500 font-medium">Documentos</span>
                            <div class="text-lg font-extrabold text-emerald-800 mt-0.5">@resultado.DocumentosImportados</div>
                        </div>
                        <div class="bg-white/80 border border-emerald-100 rounded-lg p-3 text-center">
                            <span class="text-xs text-slate-500 font-medium">Assinaturas</span>
                            <div class="text-lg font-extrabold text-emerald-800 mt-0.5">@resultado.AssinaturasImportados</div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="bg-red-50 border border-red-200 rounded-xl p-6 shadow-sm">
                    <h3 class="text-lg font-bold text-red-800 flex items-center gap-2 mb-2">
                        <span>❌</span> Falha na Ingestão
                    </h3>
                    <p class="text-red-600 text-sm">
                        @resultado.Mensagem
                    </p>
                </div>
            }
        }
    }
</div>

@code {
    private IngestaoStatsDto? stats;
    private IngestaoResult? resultado;
    private bool carregandoStats = true;
    private bool processando = false;
    private string? erroStats;

    protected override async Task OnInitializedAsync()
    {
        await CarregarStats();
    }

    private async Task CarregarStats()
    {
        carregandoStats = true;
        erroStats = null;
        try
        {
            stats = await IngestaoService.ObterEstatisticasLegadoAsync();
        }
        catch (Exception ex)
        {
            erroStats = $"Não foi possível conectar com a base legado 'sei'. Verifique se a base existe na instância LocalDB. Detalhes: {ex.Message}";
        }
        finally
        {
            carregandoStats = false;
        }
    }

    private async Task IniciarIngestao()
    {
        processando = true;
        resultado = null;
        try
        {
            resultado = await IngestaoService.IngerirDadosLegadosAsync();
            
            // Atualiza as estatísticas após a ingestão
            await CarregarStats();
        }
        catch (Exception ex)
        {
            resultado = new IngestaoResult(0, 0, 0, 0, false, $"Erro inesperado: {ex.Message}");
        }
        finally
        {
            processando = false;
        }
    }

    private async Task IniciarIngestaoLimpa()
    {
        processando = true;
        resultado = null;
        try
        {
            await IngestaoService.LimparDadosLocaisAsync();
            resultado = await IngestaoService.IngerirDadosLegadosAsync();
            await CarregarStats();
        }
        catch (Exception ex)
        {
            resultado = new IngestaoResult(0, 0, 0, 0, false, $"Erro inesperado: {ex.Message}");
        }
        finally
        {
            processando = false;
        }
    }
}
