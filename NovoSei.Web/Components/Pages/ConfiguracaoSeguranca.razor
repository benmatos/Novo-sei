@page "/seguranca"
@using Microsoft.EntityFrameworkCore
@using NovoSei.Core.Entities
@using NovoSei.Core.Interfaces
@using NovoSei.Infrastructure.Data
@using Microsoft.AspNetCore.Components.Authorization
@inject ApplicationDbContext Db
@inject ITotpService TotpService
@inject IUsuarioRepository UsuarioRepository
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Configuração de Segurança - Novo SEI</PageTitle>

<div class="container mx-auto px-6 py-8 max-w-4xl">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-3xl font-extrabold text-slate-800 tracking-tight flex items-center gap-2">
            🔐 Configurações de Segurança
        </h1>
        <p class="text-slate-500 mt-2">
            Gerencie a autenticação multifator (MFA) para proteger seu acesso ao Novo SEI.
        </p>
    </div>

    @if (usuarioLogado == null)
    {
        <div class="bg-amber-50 border-l-4 border-amber-400 p-4 rounded-r-lg shadow-sm">
            <div class="flex">
                <span class="text-amber-500 text-xl mr-3">⚠️</span>
                <div>
                    <h3 class="text-sm font-bold text-amber-800">Carregando dados do usuário...</h3>
                    <p class="text-xs text-amber-700 mt-1">Aguarde enquanto identificamos sua conta.</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Left Info Panel -->
            <div class="md:col-span-1 space-y-6">
                <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6">
                    <h2 class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-4">Seus Dados</h2>
                    <div class="space-y-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-500">Nome Completo</label>
                            <span class="block text-sm font-medium text-slate-800">@usuarioLogado.Nome</span>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-500">Login LDAP</label>
                            <span class="block text-sm font-mono text-slate-800">@usuarioLogado.Login</span>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-500">E-mail Institucional</label>
                            <span class="block text-sm font-medium text-slate-800">@usuarioLogado.Email</span>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-500">Status do 2FA</label>
                            @if (usuarioLogado.DoisFatoresHabilitado)
                            {
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 mt-1">
                                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                    Ativado
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-800 mt-1">
                                    <span class="w-2 h-2 rounded-full bg-slate-400"></span>
                                    Desativado
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <div class="bg-indigo-50 rounded-2xl border border-indigo-100 p-6 space-y-3">
                    <h3 class="text-sm font-bold text-indigo-900">Por que usar o 2FA?</h3>
                    <p class="text-xs text-indigo-700 leading-relaxed">
                        A Autenticação de Dois Fatores (2FA) adiciona uma camada extra de segurança. Mesmo que alguém descubra sua senha de rede LDAP, não conseguirá acessar seu perfil do Novo SEI sem o código gerado em tempo real no seu dispositivo.
                    </p>
                </div>
            </div>

            <!-- Right Content Panel -->
            <div class="md:col-span-2">
                <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-8 space-y-6">
                    @if (usuarioLogado.DoisFatoresHabilitado)
                    {
                        <!-- MFA Enabled Area -->
                        <div class="text-center py-8 space-y-4">
                            <div class="w-20 h-20 bg-emerald-50 text-emerald-500 rounded-full flex items-center justify-center text-4xl mx-auto shadow-inner border border-emerald-100">
                                🛡️
                            </div>
                            <div class="space-y-2">
                                <h2 class="text-2xl font-bold text-slate-800">Autenticação 2FA Ativa</h2>
                                <p class="text-sm text-slate-500 max-w-md mx-auto">
                                    Seu Novo SEI está protegido por verificação em duas etapas. Códigos adicionais serão solicitados no login.
                                </p>
                            </div>
                            <div class="bg-slate-50 rounded-xl p-4 max-w-sm mx-auto text-left border border-slate-100">
                                <span class="block text-xs font-semibold text-slate-400">E-mail Alternativo de Recuperação</span>
                                <span class="block text-sm font-medium text-slate-700">@usuarioLogado.EmailAlternativo</span>
                            </div>

                            <div class="pt-6 border-t border-slate-100">
                                @if (!confirmandoDesativacao)
                                {
                                    <button @onclick="IniciarDesativacao" class="px-5 py-2.5 rounded-xl border border-red-200 text-red-600 hover:bg-red-50 font-semibold transition-all">
                                        Desativar 2FA
                                    </button>
                                }
                                else
                                {
                                    <div class="max-w-md mx-auto bg-red-50 border border-red-100 p-6 rounded-2xl text-left space-y-4">
                                        <h3 class="text-sm font-bold text-red-800">Confirmação de Desativação</h3>
                                        <p class="text-xs text-red-700">
                                            Para desativar a verificação de dois fatores, insira o código atual do seu aplicativo autenticador.
                                        </p>
                                        <div class="space-y-2">
                                            <input type="text" maxlength="6" @bind="codigoTotpDesativacao" placeholder="Código de 6 dígitos"
                                                   class="w-full px-4 py-2.5 rounded-xl border border-red-200 text-center font-mono text-lg focus:outline-none focus:ring-2 focus:ring-red-500" />
                                            @if (!string.IsNullOrEmpty(mensagemErroDesativacao))
                                            {
                                                <span class="block text-xs text-red-600 font-medium">@mensagemErroDesativacao</span>
                                            }
                                        </div>
                                        <div class="flex gap-3 justify-end pt-2">
                                            <button @onclick="CancelarDesativacao" class="px-4 py-2 rounded-xl text-slate-600 hover:bg-slate-100 font-semibold text-xs transition-all">
                                                Cancelar
                                            </button>
                                            <button @onclick="ConfirmarDesativar2Fa" class="px-4 py-2 rounded-xl bg-red-600 text-white hover:bg-red-700 font-semibold text-xs transition-all">
                                                Confirmar Desativação
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- MFA Config Steps (Stepper) -->
                        <h2 class="text-xl font-bold text-slate-800 border-b border-slate-100 pb-4">
                            Configurar Novo Dispositivo 2FA
                        </h2>

                        <!-- Step Tabs -->
                        <div class="flex items-center gap-2 mb-6">
                            <span class="flex items-center justify-center w-8 h-8 rounded-full text-xs font-bold @(currentStep >= 1 ? "bg-indigo-600 text-white" : "bg-slate-100 text-slate-400")">1</span>
                            <span class="h-0.5 bg-slate-200 flex-1"></span>
                            <span class="flex items-center justify-center w-8 h-8 rounded-full text-xs font-bold @(currentStep >= 2 ? "bg-indigo-600 text-white" : "bg-slate-100 text-slate-400")">2</span>
                            <span class="h-0.5 bg-slate-200 flex-1"></span>
                            <span class="flex items-center justify-center w-8 h-8 rounded-full text-xs font-bold @(currentStep >= 3 ? "bg-indigo-600 text-white" : "bg-slate-100 text-slate-400")">3</span>
                        </div>

                        @if (currentStep == 1)
                        {
                            <!-- Step 1: E-mail Alternativo -->
                            <div class="space-y-4">
                                <div class="bg-indigo-50 border-l-4 border-indigo-500 p-4 rounded-r-lg">
                                    <h4 class="text-sm font-bold text-indigo-900">Passo 1: E-mail Alternativo</h4>
                                    <p class="text-xs text-indigo-700 mt-1 leading-relaxed">
                                        Forneça um endereço de e-mail de recuperação que você tenha acesso (diferente do institucional). Um token de ativação será simulado neste endereço.
                                    </p>
                                </div>

                                <div class="space-y-2">
                                    <label class="block text-sm font-semibold text-slate-700">Seu E-mail Alternativo</label>
                                    <input type="email" @bind="emailAlternativo" placeholder="exemplo@gmail.com"
                                           class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                                    @if (!string.IsNullOrEmpty(mensagemErro))
                                    {
                                        <span class="block text-xs text-red-600 font-medium">@mensagemErro</span>
                                    }
                                </div>

                                <div class="pt-4 text-right">
                                    <button @onclick="IniciarMfaConfig" class="px-5 py-3 bg-indigo-600 text-white rounded-xl font-bold hover:bg-indigo-700 shadow-md shadow-indigo-100 transition-all">
                                        Enviar E-mail de Validação
                                    </button>
                                </div>
                            </div>
                        }
                        else if (currentStep == 2)
                        {
                            <!-- Step 2: Confirmação do Token de E-mail -->
                            <div class="space-y-6">
                                <div class="bg-amber-50 border-l-4 border-amber-500 p-4 rounded-r-lg">
                                    <h4 class="text-sm font-bold text-amber-900">Passo 2: Validar E-mail</h4>
                                    <p class="text-xs text-amber-700 mt-1 leading-relaxed">
                                        Um e-mail de segurança foi enviado para <strong class="font-semibold">@emailAlternativo</strong>. Insira o token recebido no campo abaixo para prosseguir.
                                    </p>
                                </div>

                                <!-- SIMULATOR BOX -->
                                <div class="bg-slate-900 text-slate-100 p-5 rounded-2xl font-mono text-xs space-y-3 shadow-inner">
                                    <div class="flex justify-between items-center text-slate-400 border-b border-slate-800 pb-2 mb-1">
                                        <span>📧 SIMULAÇÃO DE SERVIDOR DE E-MAIL (LOG)</span>
                                        <span class="bg-indigo-900/60 px-2 py-0.5 rounded text-[10px] text-indigo-300 font-sans font-bold uppercase">Mock Service</span>
                                    </div>
                                    <p class="text-slate-300"><strong>Para:</strong> @emailAlternativo</p>
                                    <p class="text-slate-300"><strong>Assunto:</strong> Ativação de MFA no Novo SEI</p>
                                    <p class="text-indigo-300 bg-indigo-950/50 p-3 rounded-lg border border-indigo-900/50 mt-2">
                                        Olá, use o token de validação abaixo para prosseguir com a configuração do seu 2FA:<br />
                                        <strong class="text-lg text-white block mt-2 text-center select-all">@tokenAtivacaoSimulado</strong>
                                    </p>
                                    <p class="text-slate-500 text-[10px]">Expira em: @tokenExpiracaoSimulado.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") (60 minutos)</p>
                                </div>

                                <div class="space-y-2">
                                    <label class="block text-sm font-semibold text-slate-700">Token de Confirmação</label>
                                    <input type="text" @bind="tokenDigitado" placeholder="Digite o token simulado acima"
                                           class="w-full px-4 py-3 rounded-xl border border-slate-200 font-mono text-center text-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                                    @if (!string.IsNullOrEmpty(mensagemErro))
                                    {
                                        <span class="block text-xs text-red-600 font-medium">@mensagemErro</span>
                                    }
                                </div>

                                <div class="flex gap-3 justify-between pt-4">
                                    <button @onclick="VoltarPasso" class="px-5 py-3 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 font-semibold transition-all">
                                        Voltar
                                    </button>
                                    <button @onclick="ValidarTokenEmail" class="px-5 py-3 bg-indigo-600 text-white rounded-xl font-bold hover:bg-indigo-700 shadow-md shadow-indigo-100 transition-all">
                                        Validar Token
                                    </button>
                                </div>
                            </div>
                        }
                        else if (currentStep == 3)
                        {
                            <!-- Step 3: QR Code e Código TOTP -->
                            <div class="space-y-6">
                                <div class="bg-indigo-50 border-l-4 border-indigo-500 p-4 rounded-r-lg">
                                    <h4 class="text-sm font-bold text-indigo-900">Passo 3: Vincular Authenticator</h4>
                                    <p class="text-xs text-indigo-700 mt-1 leading-relaxed">
                                        Abra o aplicativo de autenticação de sua preferência (Google Authenticator, Microsoft Authenticator, etc.) e escaneie o código QR ou digite a chave de configuração manual.
                                    </p>
                                </div>

                                <div class="flex flex-col md:flex-row items-center gap-8 justify-center py-4 border border-slate-100 rounded-2xl bg-slate-50">
                                    <div class="bg-white p-3 rounded-xl shadow-sm border border-slate-200">
                                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=@Uri.EscapeDataString(qrCodeUriGenerada)"
                                             alt="QR Code Autenticador" class="w-[180px] h-[180px]" />
                                    </div>
                                    <div class="space-y-3 max-w-xs text-center md:text-left">
                                        <div>
                                            <span class="block text-[11px] font-bold text-slate-400 uppercase tracking-widest">Chave de Configuração Manual</span>
                                            <span class="block font-mono text-base font-bold text-slate-700 tracking-wider bg-slate-200/60 px-3 py-1.5 rounded-lg select-all mt-1">@segredoGerado</span>
                                        </div>
                                        <div>
                                            <span class="block text-[11px] font-bold text-slate-400 uppercase tracking-widest">Identificador</span>
                                            <span class="block text-xs font-semibold text-slate-500">NovoSEI: @usuarioLogado.Email</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="space-y-2 max-w-sm mx-auto">
                                    <label class="block text-sm font-semibold text-slate-700 text-center">Código de Confirmação (6 dígitos)</label>
                                    <input type="text" maxlength="6" @bind="codigoTotpDigitado" placeholder="Digite o código gerado no app"
                                           class="w-full px-4 py-3 rounded-xl border border-slate-200 text-center font-mono text-2xl focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                                    @if (!string.IsNullOrEmpty(mensagemErro))
                                    {
                                        <span class="block text-xs text-red-600 font-medium text-center">@mensagemErro</span>
                                    }
                                </div>

                                <div class="flex gap-3 justify-between pt-4">
                                    <button @onclick="VoltarPasso" class="px-5 py-3 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 font-semibold transition-all">
                                        Voltar
                                    </button>
                                    <button @onclick="AtivarMfaFinal" class="px-5 py-3 bg-emerald-600 text-white rounded-xl font-bold hover:bg-emerald-700 shadow-md shadow-emerald-100 transition-all">
                                        Confirmar e Ativar
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private Usuario? usuarioLogado;
    private int currentStep = 1;
    
    // Step 1 variables
    private string emailAlternativo = string.Empty;
    private string mensagemErro = string.Empty;

    // Step 2 variables
    private string tokenAtivacaoSimulado = string.Empty;
    private DateTime tokenExpiracaoSimulado;
    private string tokenDigitado = string.Empty;

    // Step 3 variables
    private string segredoGerado = string.Empty;
    private string qrCodeUriGenerada = string.Empty;
    private string codigoTotpDigitado = string.Empty;

    // Deactivation variables
    private bool confirmandoDesativacao = false;
    private string codigoTotpDesativacao = string.Empty;
    private string mensagemErroDesativacao = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CarregarUsuario();
    }

    private async Task CarregarUsuario()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var login = user.FindFirst("login")?.Value ?? user.Identity?.Name ?? "admin";

        usuarioLogado = await Db.Usuarios
            .FirstOrDefaultAsync(u => u.Login == login);

        if (usuarioLogado == null)
        {
            usuarioLogado = await Db.Usuarios.FirstOrDefaultAsync();
        }
        
        if (usuarioLogado != null && !usuarioLogado.DoisFatoresHabilitado && !string.IsNullOrEmpty(usuarioLogado.EmailAlternativo))
        {
            emailAlternativo = usuarioLogado.EmailAlternativo;
        }
    }

    private async Task IniciarMfaConfig()
    {
        mensagemErro = string.Empty;

        if (string.IsNullOrWhiteSpace(emailAlternativo) || !emailAlternativo.Contains("@"))
        {
            mensagemErro = "Por favor, insira um endereço de e-mail alternativo válido.";
            return;
        }

        // Simular envio de e-mail de ativação
        tokenAtivacaoSimulado = Guid.NewGuid().ToString()[..6].ToUpper();
        tokenExpiracaoSimulado = DateTime.UtcNow.AddMinutes(60);

        if (usuarioLogado != null)
        {
            // Salvar no banco o token temporário
            await UsuarioRepository.Atualizar2FaAsync(
                usuarioLogado.Id,
                false,
                null,
                emailAlternativo,
                tokenAtivacaoSimulado,
                tokenExpiracaoSimulado
            );

            currentStep = 2;
        }
    }

    private void VoltarPasso()
    {
        mensagemErro = string.Empty;
        if (currentStep > 1)
        {
            currentStep--;
        }
    }

    private async Task ValidarTokenEmail()
    {
        mensagemErro = string.Empty;

        if (string.IsNullOrWhiteSpace(tokenDigitado))
        {
            mensagemErro = "Insira o token de segurança enviado.";
            return;
        }

        if (usuarioLogado == null) return;

        // Recarregar usuário para validar
        var userDb = await Db.Usuarios.AsNoTracking().FirstOrDefaultAsync(u => u.Id == usuarioLogado.Id);
        
        if (userDb == null || userDb.Token2FaAtivacao != tokenDigitado || userDb.TokenEmailExpiracao < DateTime.UtcNow)
        {
            mensagemErro = "Token inválido, expirado ou incorreto.";
            return;
        }

        // Token de e-mail verificado com sucesso. Gerar segredo TOTP.
        segredoGerado = TotpService.GerarSegredoBase32();
        qrCodeUriGenerada = TotpService.GerarQrCodeUri(usuarioLogado.Email, segredoGerado);

        currentStep = 3;
    }

    private async Task AtivarMfaFinal()
    {
        mensagemErro = string.Empty;

        if (string.IsNullOrWhiteSpace(codigoTotpDigitado) || codigoTotpDigitado.Length != 6)
        {
            mensagemErro = "Insira o código de autenticação de 6 dígitos.";
            return;
        }

        if (usuarioLogado == null) return;

        // Validar código TOTP contra o segredo gerado
        var isValid = TotpService.ValidarCodigo(segredoGerado, codigoTotpDigitado);
        if (!isValid)
        {
            mensagemErro = "Código de confirmação incorreto ou expirado. Tente novamente.";
            return;
        }

        // Ativar definitivamente
        await UsuarioRepository.Atualizar2FaAsync(
            usuarioLogado.Id,
            true,
            segredoGerado,
            emailAlternativo,
            null,
            null
        );

        // Recarregar estado
        await CarregarUsuario();
        currentStep = 1;
        tokenDigitado = string.Empty;
        codigoTotpDigitado = string.Empty;
    }

    private void IniciarDesativacao()
    {
        confirmandoDesativacao = true;
        mensagemErroDesativacao = string.Empty;
        codigoTotpDesativacao = string.Empty;
    }

    private void CancelarDesativacao()
    {
        confirmandoDesativacao = false;
        mensagemErroDesativacao = string.Empty;
    }

    private async Task ConfirmarDesativar2Fa()
    {
        mensagemErroDesativacao = string.Empty;

        if (string.IsNullOrWhiteSpace(codigoTotpDesativacao) || codigoTotpDesativacao.Length != 6)
        {
            mensagemErroDesativacao = "Insira o código de segurança de 6 dígitos.";
            return;
        }

        if (usuarioLogado == null) return;

        // Validar código TOTP de desativação
        var isValid = TotpService.ValidarCodigo(usuarioLogado.Segredo2Fa ?? "", codigoTotpDesativacao);
        if (!isValid)
        {
            mensagemErroDesativacao = "Código de segurança incorreto. Não foi possível desativar.";
            return;
        }

        // Desativar no banco de dados
        await UsuarioRepository.Atualizar2FaAsync(
            usuarioLogado.Id,
            false,
            null,
            null,
            null,
            null
        );

        confirmandoDesativacao = false;
        await CarregarUsuario();
    }
}
