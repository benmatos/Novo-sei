@using NovoSei.Core.DTOs

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <!-- Card 1: Total Processos -->
    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm hover:shadow-md hover:scale-[1.01] transition-all duration-300 flex items-center justify-between">
        <div class="space-y-1.5">
            <span class="text-xs font-extrabold uppercase tracking-widest text-slate-400">Total de Processos</span>
            <h3 class="text-3xl font-black text-slate-800 tracking-tight">@Indicadores?.TotalProcessos</h3>
            <p class="text-[11px] text-slate-500 font-light">Sob sua responsabilidade</p>
        </div>
        <div class="flex items-center justify-center w-12 h-12 rounded-2xl bg-blue-50 border border-blue-100 text-blue-600 text-xl font-bold">
            📂
        </div>
    </div>

    <!-- Card 2: Processos Abertos -->
    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm hover:shadow-md hover:scale-[1.01] transition-all duration-300 flex items-center justify-between">
        <div class="space-y-1.5">
            <span class="text-xs font-extrabold uppercase tracking-widest text-slate-400">Processos Abertos</span>
            <h3 class="text-3xl font-black text-indigo-700 tracking-tight">@Indicadores?.ProcessosAbertos</h3>
            <p class="text-[11px] text-slate-500 font-light">Em andamento na caixa</p>
        </div>
        <div class="flex items-center justify-center w-12 h-12 rounded-2xl bg-indigo-50 border border-indigo-100 text-indigo-600 text-xl font-bold">
            ⚡
        </div>
    </div>

    <!-- Card 3: Rascunhos Pendentes -->
    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm hover:shadow-md hover:scale-[1.01] transition-all duration-300 flex items-center justify-between">
        <div class="space-y-1.5">
            <span class="text-xs font-extrabold uppercase tracking-widest text-slate-400">Rascunhos Pendentes</span>
            <h3 class="text-3xl font-black text-amber-600 tracking-tight">@Indicadores?.RascunhosPendentes</h3>
            <p class="text-[11px] text-slate-500 font-light">Aguardando sua assinatura</p>
        </div>
        <div class="flex items-center justify-center w-12 h-12 rounded-2xl bg-amber-50 border border-amber-100 text-amber-600 text-xl font-bold">
            ✍️
        </div>
    </div>

    <!-- Card 4: Trâmites Realizados -->
    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm hover:shadow-md hover:scale-[1.01] transition-all duration-300 flex items-center justify-between">
        <div class="space-y-1.5">
            <span class="text-xs font-extrabold uppercase tracking-widest text-slate-400">Trâmites Realizados</span>
            <h3 class="text-3xl font-black text-emerald-600 tracking-tight">@Indicadores?.TramitesRealizados</h3>
            <p class="text-[11px] text-slate-500 font-light">Assinaturas e ações efetuadas</p>
        </div>
        <div class="flex items-center justify-center w-12 h-12 rounded-2xl bg-emerald-50 border border-emerald-100 text-emerald-600 text-xl font-bold">
            🛡️
        </div>
    </div>
</div>

@code {
    [Parameter]
    public DashboardDto? Indicadores { get; set; }
}
